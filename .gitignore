## .NET build output
bin/
obj/
*.user
.vs/

dicts/

# CSDict.Scraper's local output/cache (see scripts/build-dictionaries.sh) - regenerated on
# demand and published as GitHub Release assets, never committed to git (see
# docs/design/scraper-and-distribution.md); sizes can run into the gigabytes.
dist/

# Local NuGet packages ARE tracked (src/local-packages/*.nupkg) - this repo has no package
# registry, so the prebuilt native packages are committed directly.
src/CSDict.App/Dictionaries/
src/CSDict.Gtk.Native.macOS/runtimes/osx-arm64/native/
src/CSDict.Gtk.Native.macOS/runtimes/osx-x64/native/
src/CSDict.Gtk.Native.Windows/runtimes/win-x64/native/
