<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.1.0</Version>
    <PackageId>CSDict.Gtk</PackageId>
    <Description>P/Invoke bindings for GTK 4 (GtkApplication, windows, header bar, boxes, buttons, labels, search entry, drop-down/combobox). Platform-agnostic; pair with a matching CSDict.Gtk.Native.* package that locates the native GTK 4 libraries for your platform.</Description>
  </PropertyGroup>

</Project>
