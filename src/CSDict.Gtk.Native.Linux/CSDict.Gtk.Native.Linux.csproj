<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.1.0</Version>
    <PackageId>CSDict.Gtk.Native.Linux</PackageId>
    <Description>Linux (linux-x64/linux-arm64) native library resolver for the CSDict.Gtk bindings. Locates the distro-installed GTK 4 shared libraries at runtime (via the ldconfig cache or well-known multiarch lib directories); does not bundle GTK itself, since desktop Linux users overwhelmingly already have a compatible GTK 4 install via their distro's package manager, and bundling would forgo the distro's own security-patch cadence. Pair with the CSDict.Gtk bindings package.</Description>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CSDict.Gtk/CSDict.Gtk.csproj" />
  </ItemGroup>

</Project>
