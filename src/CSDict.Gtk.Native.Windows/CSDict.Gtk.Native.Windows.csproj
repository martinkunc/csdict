<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.1</Version>
    <PackageId>CSDict.Gtk.Native.Windows</PackageId>
    <Description>Windows (win-x64) native library resolver for the CSDict.Gtk bindings. Bundles GTK 4 and its full runtime dependency closure (fetched from MSYS2's UCRT64 repository via scripts/fetch-windows-native-deps.{sh,ps1} at the repo root) so the app runs standalone without requiring GTK to be installed on the target system; falls back to an MSYS2/gvsbuild/portable install if the bundled copy is ever absent. Pair with the CSDict.Gtk bindings package.</Description>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CSDict.Gtk/CSDict.Gtk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes/win-x64/native/*"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('runtimes/win-x64/native')" />
  </ItemGroup>

</Project>
